# Copy to .env (git-ignored). All optional.
# Official translation APIs — the first configured one is used, free endpoints remain as fallback.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
GOOGLE_TRANSLATE_API_KEY=
DEEPL_API_KEY=
# Public browser key of Google's translate web widget, enables the free "google-web" fallback
# (useful when Google rate-limits the gtx endpoint for your server's IP).
GOOGLE_WEB_KEY=
# TRANSLATOR_PROVIDER=azure|google|deepl|google-free|google-web
# PORT=3000
# REFRESH_INTERVAL_MIN=30
# Optional official Azure Speech for TTS (otherwise free Edge neural voices / Google TTS)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
