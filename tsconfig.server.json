{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "types": ["node"]
  },
  "include": ["src/server", "src/core", "src/lib", "src/shared", "scripts/*.ts", "netlify/**/*.ts", "netlify/**/*.mts"]
}
